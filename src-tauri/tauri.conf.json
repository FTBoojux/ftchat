{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "identifier": "com.boojux.ftchat",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ftchat",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities":[
        {
          "identifier": "main",
          "windows": ["*"],
          "permissions": ["sql:default","sql:allow-execute"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../.icons/32x32.png",
      "../.icons/128x128.png",
      "../.icons/128x128@2x.png",
      "../.icons/icon.icns"
    ]
  },
  "plugins":{
    "sql": {
      "preload": ["sqlite:mydatabase.db"]
    }
  } 
}
